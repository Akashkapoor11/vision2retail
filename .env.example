# Local demo configuration. Never commit real secrets.
POSTGRES_DB=vision2retail
POSTGRES_USER=vision2retail
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://vision2retail:change-me-local-only@db:5432/vision2retail
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data/media
YOLO_CONFIG_DIR=/data/ultralytics
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=auto
TRACKER_CONFIG=bytetrack.yaml
CONFIDENCE_THRESHOLD=0.25
IMAGE_SIZE=640
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=180
ANALYTICS_SAMPLE_EVERY_N_FRAMES=5
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional secondary API origin for read-only failover. Leave blank to use labeled demo data.
NEXT_PUBLIC_API_FALLBACK_URL=
